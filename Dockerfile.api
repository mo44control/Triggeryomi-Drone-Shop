# ── Stage 1: build ──────────────────────────────────────────────────────────
# Use Debian (glibc) — matches Replit's env; pnpm-workspace.yaml overrides
# exclude musl binaries so Alpine (musl) builds will fail for rollup/tailwind/etc.
FROM node:24-slim AS builder
WORKDIR /app

RUN npm install -g pnpm@10.11.0 --quiet

# Copy full workspace so pnpm can resolve all packages correctly
COPY . .

RUN pnpm install --no-frozen-lockfile

# Build the esbuild bundle
RUN pnpm --filter @workspace/api-server run build

# ── Stage 2: run ─────────────────────────────────────────────────────────────
FROM node:24-slim
WORKDIR /app

RUN npm install -g pnpm@10.11.0 --quiet

# Keep full workspace for drizzle-kit migrations
COPY . .

RUN pnpm install --no-frozen-lockfile

# Overwrite with the compiled bundle from the builder stage
COPY --from=builder /app/artifacts/api-server/dist ./artifacts/api-server/dist

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PORT=8080
ENV NODE_ENV=production
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
