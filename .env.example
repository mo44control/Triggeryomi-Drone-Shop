# TriggeryOmi Drones — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/triggeryomi

# Secret used to sign admin session cookies (required — use a long random string)
SESSION_SECRET=change-me-to-a-long-random-secret-string

# Port for the API server (defaults assigned by workflow config in Replit)
# PORT=8080
