# ── Stage 1: build ──────────────────────────────────────────────────────────
# Use Debian (glibc) — matches Replit's env; pnpm-workspace.yaml overrides
# exclude musl binaries so Alpine (musl) builds will fail for rollup/tailwind/etc.
FROM node:24-slim AS builder
WORKDIR /app

RUN npm install -g pnpm@10.11.0 --quiet

# Copy full workspace so pnpm can resolve all packages correctly
COPY . .

RUN pnpm install --no-frozen-lockfile

# Vite requires PORT and BASE_PATH at config-parse time
ENV PORT=3000
ENV BASE_PATH=/
ENV NODE_ENV=production

RUN pnpm --filter @workspace/triggeryomi run build

# ── Stage 2: serve ───────────────────────────────────────────────────────────
FROM nginx:alpine
COPY --from=builder /app/artifacts/triggeryomi/dist/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
